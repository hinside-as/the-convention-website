---
import { site } from "../../data/site";
---

<section class="reveal py-32 text-center">
  <div class="mx-auto flex max-w-2xl flex-col gap-2 px-4 font-title text-4xl font-black text-cyan-100 sm:text-6xl">
    <p>{site.event.dateRangeShort}</p>
    <p>{site.event.dayRange}</p>
    <p>{site.venue.name}</p>
    <p>{site.venue.city}</p>
  </div>
</section>
