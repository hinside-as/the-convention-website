---
import Button from "../ui/Button.astro";
import { site } from "../../data/site";

export interface Props {
  /** "home" shows a short teaser with a link to the full guide; "full" includes the step-by-step guide. */
  variant?: "home" | "full";
  id?: string;
  bg?: "default" | "panel";
}

const { variant = "home", id, bg = "panel" } = Astro.props;
---

<section id={id} class:list={["reveal scroll-mt-32 py-32 text-center", bg === "panel" && "bg-purple-900"]}>
  <div class="mx-auto max-w-2xl px-4 sm:px-6">
    <h2 class="font-title text-3xl font-black text-cyan-100">Grasrotandelen</h2>
    <p class="mt-5 font-body text-lg text-cyan-100">
      Visste du at du kan støtte The Convention helt gratis når du spiller hos Norsk Tipping? Gjennom
      Grasrotandelen går inntil 7 % av innsatsen din direkte til oss – uten at det koster deg noe ekstra.
    </p>
    {
      variant === "full" && (
        <ol class="mt-6 flex list-inside list-decimal flex-col gap-2 text-left font-body text-cyan-100">
          <li>Logg inn på norsk-tipping.no eller i appen.</li>
          <li>Gå til «Min side» → «Grasrotandelen».</li>
          <li>
            Søk opp The Convention, eller skriv inn org.nr. {site.org.orgNumber}.
          </li>
          <li>Velg oss som din grasrotmottaker – ferdig!</li>
        </ol>
      )
    }
    <Button href={site.links.grasrotandelen} external class="mt-8 inline-flex">
      Velg The Convention som grasrotmottaker
    </Button>
    {
      variant === "home" && (
        <p class="mt-4 font-body text-sm">
          <a
            href="/stotte#grasrotandelen"
            class="cursor-pointer text-cyan-200 underline decoration-dotted underline-offset-2 transition-colors hover:text-magenta"
          >
            Les mer om Grasrotandelen
          </a>
        </p>
      )
    }
  </div>
</section>
