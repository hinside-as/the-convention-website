---
import { Image } from "astro:assets";
import type { Sponsor } from "../../data/sponsors";

export interface Props {
  sponsor: Sponsor;
  /** Which logo variant to render, based on the section's background color. */
  background?: "dark" | "light";
}

const { sponsor, background = "dark" } = Astro.props;
// "dark" background section -> light-colored (cyan) logo, and vice versa.
const logo = background === "dark" ? sponsor.logoLight : sponsor.logoDark;
---

<a
  href={sponsor.url}
  target="_blank"
  rel="noopener noreferrer"
  class="flex cursor-pointer items-center justify-center p-4 opacity-80 transition-opacity hover:opacity-100"
>
  <Image src={logo} alt={sponsor.name} class="h-10 w-auto max-w-[140px] object-contain" />
</a>
