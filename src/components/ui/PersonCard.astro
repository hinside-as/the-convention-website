---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export interface Props {
  name?: string;
  role?: string;
  email?: string;
  phone?: string;
  photo?: ImageMetadata;
}

const { name = "Navn kommer", role, email, phone, photo } = Astro.props;
---

<div class="flex flex-col items-center text-center">
  <div class="flex h-24 w-24 items-center justify-center overflow-hidden rounded-full bg-purple-600">
    {
      photo ? (
        <Image src={photo} alt={name} width={96} height={96} class="h-full w-full object-cover" />
      ) : (
        <svg viewBox="0 0 24 24" fill="none" class="h-12 w-12 text-cyan-100" aria-hidden="true">
          <circle cx="12" cy="8" r="4" fill="currentColor" />
          <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      )
    }
  </div>
  <p class="mt-3 font-title text-base font-black text-cyan-100">{name}</p>
  {role && <p class="font-pixel text-sm text-magenta">{role}</p>}
  <div class="mt-2 flex items-center justify-center gap-4">
    {
      email ? (
        <a href={`mailto:${email}`} class="text-cyan-200 transition-colors hover:text-magenta">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6zm-2 0-8 5-8-5h16zm0 12H4V8l8 5 8-5v10z" />
          </svg>
          <span class="sr-only">Send e-post</span>
        </a>
      ) : (
        <span class="text-cyan-200/40">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6zm-2 0-8 5-8-5h16zm0 12H4V8l8 5 8-5v10z" />
          </svg>
          <span class="sr-only">E-post kommer</span>
        </span>
      )
    }
    {
      phone ? (
        <a href={`tel:${phone.replace(/\s+/g, "")}`} class="text-cyan-200 transition-colors hover:text-magenta">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M6.54 5c.06.89.21 1.76.45 2.59l-1.2 1.2c-.41-1.2-.67-2.47-.76-3.79h1.51m9.86 12.02c.85.24 1.72.39 2.6.45v1.49c-1.32-.09-2.59-.35-3.8-.75l1.2-1.19M7.5 3H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.49c0-.55-.45-1-1-1-1.24 0-2.45-.2-3.57-.57a.84.84 0 0 0-.31-.05c-.26 0-.51.1-.71.29l-2.2 2.2a15.149 15.149 0 0 1-6.59-6.59l2.2-2.2c.28-.28.36-.67.25-1.02A11.36 11.36 0 0 1 8.5 4c0-.55-.45-1-1-1z" />
          </svg>
          <span class="sr-only">Ring</span>
        </a>
      ) : (
        <span class="text-cyan-200/40">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M6.54 5c.06.89.21 1.76.45 2.59l-1.2 1.2c-.41-1.2-.67-2.47-.76-3.79h1.51m9.86 12.02c.85.24 1.72.39 2.6.45v1.49c-1.32-.09-2.59-.35-3.8-.75l1.2-1.19M7.5 3H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.49c0-.55-.45-1-1-1-1.24 0-2.45-.2-3.57-.57a.84.84 0 0 0-.31-.05c-.26 0-.51.1-.71.29l-2.2 2.2a15.149 15.149 0 0 1-6.59-6.59l2.2-2.2c.28-.28.36-.67.25-1.02A11.36 11.36 0 0 1 8.5 4c0-.55-.45-1-1-1z" />
          </svg>
          <span class="sr-only">Telefon kommer</span>
        </span>
      )
    }
  </div>
</div>
