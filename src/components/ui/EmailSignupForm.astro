---
---

<form
  id="signup-form"
  action="/subscribe"
  method="POST"
  class="mx-auto flex max-w-md flex-col gap-3 sm:flex-row"
>
  <label for="signup-email" class="sr-only">E-postadresse</label>
  <input
    id="signup-email"
    type="email"
    name="email"
    required
    placeholder="din@epost.no"
    class="flex-1 rounded-full border-2 border-cyan-100 bg-transparent px-5 py-3 font-body text-cyan-100 placeholder:text-cyan-200/60 focus:border-magenta focus:outline-none"
  />
  <!-- honeypot: hidden from real users, filters basic bots server-side -->
  <input type="text" name="company" class="hidden" tabindex="-1" autocomplete="off" />
  <button
    type="submit"
    class="cursor-pointer rounded-full bg-magenta px-6 py-3 font-title font-black uppercase tracking-wide text-purple-950 transition-colors hover:bg-cyan-400"
  >
    Registrer
  </button>
</form>
<p id="signup-message" class="mt-3 text-center font-body text-sm text-cyan-200" role="status"></p>

<script>
  const form = document.getElementById("signup-form") as HTMLFormElement | null;
  const message = document.getElementById("signup-message");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!message) return;

    const formData = new FormData(form);
    try {
      const response = await fetch(form.action, { method: "POST", body: formData });
      if (response.ok) {
        message.textContent = "Takk! Du er nå med i nerdetroppen.";
        form.reset();
      } else {
        message.textContent = "Noe gikk galt. Prøv igjen senere.";
      }
    } catch {
      message.textContent = "Noe gikk galt. Prøv igjen senere.";
    }
  });
</script>
