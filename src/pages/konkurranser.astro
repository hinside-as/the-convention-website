---
import BaseLayout from "../layouts/BaseLayout.astro";
import VideoHero from "../components/sections/VideoHero.astro";
import CompetitionCard from "../components/ui/CompetitionCard.astro";
import ActivityCard from "../components/ui/ActivityCard.astro";
import { competitions, otherActivities, closingNote } from "../data/competitions";
---

<BaseLayout
  title="Konkurranser"
  description="Se alle konkurransene på The Convention 2026 – gaming-turneringer, laser tag og mye mer."
>
  <VideoHero />

  <section class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-4 py-24 sm:px-6 md:grid-cols-2 lg:grid-cols-3">
    {competitions.map((competition) => <CompetitionCard competition={competition} />)}
  </section>

  {otherActivities.length > 0 && (
    <section class="mx-auto flex max-w-4xl flex-col gap-8 px-4 pb-20 sm:px-6">
      {otherActivities.map((activity) => <ActivityCard activity={activity} />)}
    </section>
  )}

  <section class="reveal bg-purple-900 py-32 text-center">
    <p class="mx-auto max-w-3xl px-4 font-body text-lg text-cyan-100 sm:px-6">
      For å delta i konkurransene, må du ha gyldig billett for den aktuelle dagen som konkurransen foregår.{" "}
      {closingNote}
    </p>
  </section>
</BaseLayout>
